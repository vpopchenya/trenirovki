---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import CareNote from "../../components/CareNote.astro";
import { allBasics, articleLd, breadcrumbs } from "../../lib/catalog";

export async function getStaticPaths() {
  return (await allBasics()).map(a => ({ params: { id: a.id }, props: { a } }));
}
const { a } = Astro.props;
const { name, title, description, sources, published } = a.data;
const { Content } = await render(a);
const base = import.meta.env.BASE_URL;
const path = `${base}osnovy/${a.id}/`;
---
<Base nav="basics" back={{ href: `${base}osnovy/`, label: "Основы", alsoFrom: { path: `${base}programmy/`, label: "Программа" } }} title={title} description={description}
  jsonLd={[
    breadcrumbs(Astro.site!, [["Каталог", base], ["Основы", `${base}osnovy/`], [name, path]]),
    articleLd(Astro.site!, { title, description, published, path }),
  ]}>
  <article class="article">
    <nav class="crumbs" aria-label="Путь"><a href={base}>Каталог</a><span>/</span><a href={`${base}osnovy/`}>Основы</a><span>/</span><span>{name}</span></nav>
    <h1 data-testid="article-title">{title}</h1>
    <p class="lead">{description}</p>
    <div class="body" data-testid="article-body"><Content /></div>
    <CareNote basics />
    <section class="sources" data-testid="article-sources">
      <h2>Откуда цифры</h2>
      <ul>{sources.map(s => <li><a href={s.url}>{s.title}</a></li>)}</ul>
    </section>
    <a class="btn main to-programs" href={`${base}programmy/`} data-testid="article-programs">Выбрать программу →</a>
  </article>
</Base>

<style>
  .article { max-width: 70ch; display: grid; gap: 14px; }
  .article .crumbs { margin-bottom: 2px; }
  /* Текст статьи приходит из Markdown, поэтому стили глобальные, но только внутри .body. */
  .body :global(h2) { margin: 26px 0 8px; }
  .body :global(p), .body :global(ul) { margin: 0 0 10px; color: var(--text); }
  .body :global(ul) { padding-left: 22px; }
  .body :global(li) { margin-bottom: 6px; }
  .body :global(strong) { color: var(--fg); font-weight: 800; }
  .sources { font-size: 14px; color: var(--muted); }
  .sources ul { margin: 8px 0 0; padding-left: 20px; }
  .sources a { text-underline-offset: 2px; overflow-wrap: anywhere; }
  .to-programs { justify-self: start; min-height: 48px; }
</style>
