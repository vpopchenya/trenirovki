---
import Base from "../../layouts/Base.astro";
import BasicsCards from "../../components/BasicsCards.astro";
import { breadcrumbs } from "../../lib/catalog";

const base = import.meta.env.BASE_URL;
---
<Base nav="basics" back={{ href: base, label: "Каталог" }} title="Основы: сон и питание"
  description="Зачем тем, кто тренируется, нужны сон и нормальное питание. Короткие статьи с общими правилами, без диет."
  jsonLd={breadcrumbs(Astro.site!, [["Каталог", base], ["Основы", `${base}osnovy/`]])}>
  <div class="intro">
    <nav class="crumbs" aria-label="Путь"><a href={base}>Каталог</a><span>/</span><span>Основы</span></nav>
    <h1 data-testid="basics-title">Не только <em class="wave">зал</em></h1>
    <p class="lead">Результат дают три вещи вместе: тренировки, еда и сон. Тренировка даёт телу нагрузку, из еды оно берёт материал и энергию, а восстанавливается в отдыхе. Без любой из трёх остальные работают хуже.</p>
  </div>
  <BasicsCards />
  <a class="btn main to-programs" href={`${base}programmy/`} data-testid="basics-programs">Выбрать программу →</a>
</Base>

<style>
  .intro { display: grid; margin-bottom: 20px; }
  .intro .lead { margin-top: 14px; }
  .to-programs { margin-top: 20px; min-height: 48px; }
</style>
