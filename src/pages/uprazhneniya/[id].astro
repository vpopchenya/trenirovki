---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import BodyMap from "../../components/BodyMap.astro";
import groups from "../../data/groups.json";
import CareNote from "../../components/CareNote.astro";
import { allPrograms, equipmentText, levelClass, levelLabel, slugify, breadcrumbs, BAND_SAFETY } from "../../lib/catalog";
import { sideOf } from "../../lib/groups";

export async function getStaticPaths() {
  const [all, programs] = await Promise.all([getCollection("exercises"), allPrograms()]);
  return all.map(e => ({
    params: { id: e.id },
    props: { ex: e, inPrograms: programs.filter(p => p.days.some(d => d.items.some(i => i.ex.id === e.id))) },
  }));
}
const { ex, inPrograms } = Astro.props;
const e = ex.data;
const group = groups.find(g => g.id === e.group)!;
const base = import.meta.env.BASE_URL;
const [v] = e.videos;
const errors = e.equipment.includes("Резинка") ? [...e.errors, BAND_SAFETY] : e.errors;
---
<Base back={{ href: `${base}myshcy/${group.slug}/`, label: group.name, group: group.id, alsoFrom: { path: `${base}programmy/`, label: "Программа" } }} jsonLd={breadcrumbs(Astro.site!, [
  ["Каталог", base], [group.name, `${base}myshcy/${group.slug}/`],
  [e.sub, `${base}myshcy/${group.slug}/${slugify(e.sub)}/`], [e.name, `${base}uprazhneniya/${ex.id}/`],
])} title={`${e.name}: техника`} description={`${e.name}: как делать по шагам и частые ошибки. Работает ${group.acc} (${e.sub.toLowerCase()}), помогают: ${e.helpers.join(", ").toLowerCase() || "—"}.`}>
  <div style={`--gc: var(--g-${group.id}); --gi: var(--gi-${group.id})`}>
    <nav class="crumbs" aria-label="Путь"><a href={base}>Каталог</a><span>/</span><a href={`${base}myshcy/${group.slug}/`}>{group.name}</a><span>/</span><a href={`${base}myshcy/${group.slug}/${slugify(e.sub)}/`}>{e.sub}</a><span>/</span><span>{e.name}</span></nav>
    <h1 data-testid="exercise-title">{e.name}</h1>
    <p class="meta">{equipmentText(e.equipment)} · <span class={levelClass(e.level)}>{levelLabel(e.level).toLowerCase()}</span></p>

    <div class="exgrid">
      <div class="main">
        <div class="video" data-id={v.id} data-testid="video">
          <img src={`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`} alt="" loading="lazy" crossorigin="anonymous" width="480" height="360" />
          <button class="play" type="button" data-testid="video-play" data-title={v.title} aria-label={`Смотреть ролик: ${v.title}`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3l16 9-16 9z" /></svg></button>
          <span class="note">{v.channel}{v.lang === "en" && " · англ."}</span>
          <span class="offline">Ролик откроется, когда будет интернет</span>
        </div>
        {e.videos.length > 1 && (
          <div class="authors" role="group" aria-label="Кто показывает" data-testid="video-authors">
            {e.videos.map((x, i) => (
              <button class="author" type="button" aria-pressed={String(i === 0)} data-id={x.id} data-title={x.title} data-note={x.lang === "en" ? `${x.channel} · англ.` : x.channel} data-testid={`video-author-${i}`}>
                {x.author}
              </button>
            ))}
          </div>
        )}
        <div class="quick" data-testid="exercise-facts">
          <div><span>Подходы</span><b>{e.sets}</b></div>
          <div><span>Отдых</span><b>{e.rest}</b></div>
        </div>

        <section class="sect">
          <h2>Как делать</h2>
          <ol class="steps" data-testid="steps">{e.steps.map(s => <li>{s}</li>)}</ol>
        </section>
        {e.noBand && (
          <section class="sect">
            <h2>Нет резинки?</h2>
            <p class="noband" data-testid="no-band">{e.noBand}</p>
          </section>
        )}
        <section class="sect errbox">
          <h2>Частые ошибки</h2>
          <ul class="errs" data-testid="errors">
            {errors.map(s => <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg><span>{s}</span></li>)}
          </ul>
        </section>
        <div class="hist" data-exercise={ex.id}></div>
        {inPrograms.length > 0 && (
          <section class="sect" data-testid="in-programs">
            <h2>Входит в программы</h2>
            <ul class="inprog">
              {inPrograms.map(p => <li><a href={`${base}programmy/${p.id}/`} data-testid="in-program-link">{p.name}</a></li>)}
            </ul>
          </section>
        )}
      </div>

      <aside class="side">
        <div class="box">
          <BodyMap selected={group.id} side={sideOf(group, e.sub)} compact />
          <div class="mus">
            <div><i></i>{group.name} · {e.sub.toLowerCase()} — основная</div>
            {e.helpers.map(h => <div class="sec"><i></i>{h} — помогает</div>)}
          </div>
        </div>
        <CareNote />
      </aside>
    </div>
  </div>
</Base>

<script>
  import { showHistory } from "../../lib/diary/history";
  const hist = document.querySelector<HTMLElement>(".hist")!;
  showHistory(hist);
  // Вернулись «Назад» из кэша браузера: за это время могла закончиться тренировка.
  addEventListener("pageshow", ev => { if (ev.persisted) showHistory(hist); });
</script>

<script>
  dispatchEvent(new CustomEvent("goal", { detail: "exercise_open" }));
  // Плеер YouTube грузим только по нажатию: страница открывается быстро и без чужих cookie.
  // Под плеером — выбор автора: меняем ролик в той же рамке, и если он уже играл, сразу запускаем новый.
  const box = document.querySelector<HTMLElement>(".video")!;
  const facade = [...box.children];
  const img = box.querySelector("img")!, play = box.querySelector<HTMLButtonElement>(".play")!, note = box.querySelector(".note")!;
  const start = () => {
    if (!navigator.onLine) { box.classList.add("is-offline"); return; }
    const f = document.createElement("iframe");
    f.src = `https://www.youtube-nocookie.com/embed/${box.dataset.id}?autoplay=1&rel=0`;
    f.title = play.dataset.title!;
    f.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
    f.allowFullscreen = true;
    box.replaceChildren(f);
  };
  // Цель «смотрел ролик» — только по нажатию ▶, смена автора во время просмотра её не повторяет.
  play.addEventListener("click", () => { dispatchEvent(new CustomEvent("goal", { detail: "video_play" })); start(); });
  document.querySelector(".authors")?.addEventListener("click", ev => {
    const b = (ev.target as Element).closest<HTMLButtonElement>(".author");
    if (!b || b.getAttribute("aria-pressed") === "true") return;
    document.querySelectorAll(".author").forEach(x => x.setAttribute("aria-pressed", String(x === b)));
    const playing = !!box.querySelector("iframe");
    box.dataset.id = b.dataset.id;
    img.src = `https://i.ytimg.com/vi/${b.dataset.id}/hqdefault.jpg`;
    play.dataset.title = b.dataset.title;
    play.setAttribute("aria-label", `Смотреть ролик: ${b.dataset.title}`);
    note.textContent = b.dataset.note!;
    box.classList.remove("is-offline");
    // Сначала всегда возвращаем превью: без интернета не должен остаться играть ролик прежнего автора.
    box.replaceChildren(...facade);
    if (playing) start();
  });
</script>

<style>
  .meta { margin: 6px 0 0; font-size: 14px; font-weight: 700; color: var(--soft); }
  .meta span { font-weight: 800; }
  .exgrid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 28px; align-items: start; margin-top: 20px; }
  @media (min-width: 1024px) {
    .exgrid { grid-template-columns: minmax(0, 1fr) minmax(0, 360px); gap: 32px; }
    .side { position: sticky; top: 76px; }
  }
  .video { aspect-ratio: 16 / 9; max-width: 100%; border-radius: 24px; background: var(--surface); display: grid; place-items: center; position: relative; overflow: hidden; }
  .video img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: .55; }
  .video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .play { position: relative; width: 72px; height: 72px; border-radius: 50%; background: var(--accent); display: grid; place-items: center; border: 0; cursor: pointer; }
  .play svg { width: 26px; fill: var(--accent-ink); margin-left: 4px; }
  .note { position: absolute; left: 14px; right: 14px; bottom: 12px; font-weight: 700; font-size: 13px; color: var(--fg); text-shadow: 0 1px 4px #000;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .offline { display: none; position: absolute; top: 12px; left: 14px; font-size: 13px; background: var(--bg); padding: 4px 10px; border-radius: 8px; }
  .is-offline .offline { display: block; }
  .authors { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 12px; }
  .author { font-weight: 800; font-size: 14px; color: var(--fg); background: var(--surface); border: 0; border-radius: 999px;
    padding: 0 14px; min-height: 44px; cursor: pointer; transition: background .15s, color .15s, transform .1s; -webkit-tap-highlight-color: transparent; }
  .author[aria-pressed="true"] { background: var(--fg); color: var(--bg); }
  .author:active { transform: scale(.95); }
  @media (hover: hover) { .author[aria-pressed="false"]:hover { background: var(--surface2); } }
  @media (prefers-reduced-motion: reduce) { .author { transition: none; } }
  .sect { margin-top: 28px; }
  .sect h2 { margin-bottom: 14px; }
  .quick { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin-top: 16px; }
  .quick div { display: grid; background: var(--surface); border-radius: 18px; padding: 12px 14px; }
  .quick span { font-size: 13px; font-weight: 700; color: var(--soft); }
  .quick b { font-size: 16px; font-weight: 800; }
  /* Шаги: номер в кружке цвета группы, без плашек. Ошибки: спокойная карточка с крестиком. */
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; counter-reset: s; }
  .steps li { counter-increment: s; display: grid; grid-template-columns: 36px minmax(0, 1fr); gap: 12px; align-items: start; color: var(--text); font-size: 16px; line-height: 1.45; }
  .steps li::before { content: counter(s); width: 36px; height: 36px; border-radius: 50%; background: var(--gc); background: color-mix(in srgb, var(--gc) 92%, #000); color: var(--gi);
    display: grid; place-items: center; font: 800 14px var(--f-display); }
  .errbox { background: var(--surface); border-radius: 24px; padding: 16px 18px; }
  .errbox h2 { margin-bottom: 10px; }
  .errs { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .errs li { display: grid; grid-template-columns: 22px minmax(0, 1fr); gap: 8px; color: var(--text); font-size: 15px; line-height: 1.4; }
  .errs svg { width: 20px; height: 20px; margin-top: 1px; fill: none; stroke: var(--accent); stroke-width: 2.6; stroke-linecap: round; }
  /* Программ у базовых упражнений больше десяти: на широком экране — в две колонки, чтобы блок не тянулся на экран. */
  .inprog { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); gap: 8px; }
  .inprog a { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 48px; height: 100%; box-sizing: border-box; padding: 8px 14px; background: var(--surface); border-radius: 16px; color: var(--fg); font-weight: 700; text-decoration: none; }
  /* На телефоне наведения нет: без стрелки плашка не отличается от простого текста. */
  .inprog a::after { content: "→"; color: var(--accent); }
  @media (hover: hover) { .inprog a:hover { background: var(--surface2); } }
  /* Разметку блока рисует скрипт, поэтому :global. Пустой блок места не занимает. */
  .hist:not(:empty) { margin-top: 28px; }
  .hist :global(h2) { margin-bottom: 14px; }
  .hist :global(ul) { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .hist :global(li) { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 2px 14px; background: var(--surface); border-radius: 16px; padding: 12px 14px; }
  .hist :global(li span) { color: var(--muted); }
  .hist :global(li b) { font-weight: 800; color: var(--fg); }
  .noband { margin: 0; background: var(--surface); border-radius: 20px; padding: 12px 14px; color: var(--fg); font-size: 16.5px; }
  .side { display: grid; gap: 12px; }
  .box { background: var(--surface); border-radius: 24px; padding: 16px; }
  .mus { display: grid; gap: 6px; margin-top: 12px; font-size: 14px; }
  .mus div { display: flex; align-items: center; gap: 8px; }
  .mus i { width: 10px; height: 10px; border-radius: 50%; background: var(--gc); flex: none; }
  .mus .sec i { background: transparent; box-shadow: inset 0 0 0 2px var(--muted); }
</style>
