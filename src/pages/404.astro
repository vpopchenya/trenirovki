---
import Base from "../layouts/Base.astro";
const base = import.meta.env.BASE_URL;
---
<Base title="Страница не найдена" description="Такой страницы нет." noindex>
  <h1>Такой страницы нет</h1>
  <p class="lead" style="margin-top:12px">Возможно, упражнение переехало. <a href={base}>Вернуться в каталог</a>.</p>
</Base>
