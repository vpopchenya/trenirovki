---
import Base from "../layouts/Base.astro";
import { METRIKA_ID, CONSENT_KEY } from "../lib/analytics";
const base = import.meta.env.BASE_URL;
---
<Base title="О проекте" description="Карманный тренер — бесплатный каталог упражнений с техникой на русском. Кто делает, откуда материалы." nav="none" back={{ href: base, label: "Каталог" }}>
  <div class="about">
    <h1>О <em class="wave">проекте</em></h1>
    <p class="lead">Карманный тренер — бесплатный помощник для зала и дома: упражнения с техникой на русском и готовые программы. Скоро появится дневник тренировок.</p>
    <p class="warn" data-testid="health-warning">Мы не врачи и не тренеры. Есть болезни или травмы — сначала к врачу.</p>

    <section class="card" data-testid="sources">
      <h2>Откуда материалы</h2>
      <h3>Схема тела</h3>
      <p>Рисунок мышц взят из проекта react-native-body-highlighter, © 2022 ELABBASSI Hicham, <a href={`${base}licenses/body-highlighter.txt`}>лицензия MIT</a>.</p>
      <h3>Ролики</h3>
      <p>Ролики принадлежат их авторам: имя указано под плеером. Мы их не копируем, а показываем через плеер YouTube, когда ты нажимаешь ▶.</p>
    </section>

    <section class="card" id="privacy" data-testid="privacy">
      <h2>Конфиденциальность</h2>
      <p class="sub">Мы не собираем личные данные. Регистрации нет, имя, телефон и почта не нужны.</p>
      <h3>Что хранится у тебя</h3>
      <p>Сайт сохраняется на телефоне или в браузере, чтобы открываться без интернета. Там же лежит выбранная программа. Всё это никуда не отправляется. Удалить можно очисткой данных сайта в браузере, а программу — ещё и кнопкой «Моя программа».</p>
      <h3>Что видят другие сервисы</h3>
      <p>Сайт лежит на GitHub Pages, поэтому GitHub видит IP-адрес посетителя, как любой хостинг. Превью роликов загружаются с YouTube, поэтому он тоже видит IP-адрес. Сам ролик запускается только после нажатия ▶, в режиме повышенной конфиденциальности, но после запуска YouTube может сохранять свои данные в браузере. Дальше действуют правила GitHub и Google.</p>
      <h3>Аналитика</h3>
      <p>Если подключим Яндекс Метрику, она заработает только после твоего согласия в плашке внизу экрана, и здесь появится подробный текст.</p>
      {METRIKA_ID && <p><button class="btn reset" type="button" data-key={CONSENT_KEY} data-testid="consent-reset">Изменить выбор по аналитике</button></p>}
    </section>
  </div>
</Base>

<script>
  // Отозвать или дать согласие так же просто, как в плашке: стираем выбор и перезагружаем — плашка появится снова.
  document.querySelector<HTMLButtonElement>(".reset")?.addEventListener("click", ev => {
    try { localStorage.removeItem((ev.currentTarget as HTMLElement).dataset.key!); } catch {}
    location.reload();
  });
</script>

<style>
  .about { max-width: 70ch; display: grid; gap: 16px; }
  .about p { margin: 0; color: var(--fg2); }
  .about .lead { color: var(--text); }
  .card { background: var(--surface); border-radius: 20px; padding: 20px 18px; display: grid; gap: 8px; }
  .card h2 { margin: 0; }
  .card .sub { color: var(--text); }
  .card h3 { margin: 12px 0 0; font-size: 16px; color: var(--fg); }
  .reset { background: transparent; border: 1px solid var(--line); }
  .warn { font-size: 14px; border: 1px dashed var(--line); border-radius: 14px; padding: 12px 14px; }
</style>
