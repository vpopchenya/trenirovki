---
import Base from "../layouts/Base.astro";
import BodyMap from "../components/BodyMap.astro";
import InstallCard from "../components/InstallCard.astro";
import { getCollection } from "astro:content";
import groups from "../data/groups.json";
import { allPrograms, plural, MY_PROGRAM_KEY } from "../lib/catalog";

const all = await getCollection("exercises");
const count = (id: string) => all.filter(e => e.data.group === id).length;
const base = import.meta.env.BASE_URL;
const first = groups[0];
const countText = (id: string) => (count(id) ? `${count(id)} ${plural(count(id))}` : "скоро");
const programNames = Object.fromEntries((await allPrograms()).map(p => [p.id, p.name]));
---
<Base jsonLd={{ "@context": "https://schema.org", "@type": "WebSite", name: "Карманный тренер", inLanguage: "ru", url: new URL(base, Astro.site).href }} title="Карманный тренер" description="Бесплатный каталог упражнений для зала и дома: 7 групп мышц, техника по шагам на русском и частые ошибки. Работает на телефоне.">
  <div class="home">
    <div class="hello">
      <h1 data-testid="home-title">Что качаем <em class="hl">сегодня?</em></h1>
      <div class="programs mine" data-testid="home-my-program" hidden>
        <a data-testid="home-my-program-link"><b>Моя программа</b><small></small></a>
        <a class="btn main" href={`${base}trenirovka/`} data-testid="home-start-workout">Начать тренировку</a>
      </div>
      {/* Сразу за разметкой, чтобы карточка не прыгала. Имени нет в списке (программу убрали) — главная как обычно.
          pageshow — вернулись «Назад» из кэша браузера, а выбор мог поменяться. */}
      <script is:inline define:vars={{ KEY: MY_PROGRAM_KEY, names: programNames, base }}>
        const mine = document.querySelector(".mine");
        const show = () => {
          let id = null;
          try { id = localStorage.getItem(KEY); } catch {}
          const known = Object.keys(names).includes(id);
          mine.hidden = !known;
          if (!known) return;
          mine.querySelector("a").href = `${base}programmy/${id}/`;
          mine.querySelector("small").textContent = names[id];
        };
        show();
        addEventListener("pageshow", show);
      </script>
    </div>

    <section class="map" aria-label="Выбор мышцы">
      <BodyMap selected={first.id} clickable />
      <div class="pick" data-testid="picked-group">
        <span><b class="pn">{first.name}</b><small class="ps">{countText(first.id)}</small></span>
        <a class="btn main" href={`${base}myshcy/${first.slug}/`}>Упражнения</a>
      </div>
    </section>

    <div class="left">
      <InstallCard />
      <a class="programs" href={`${base}programmy/`} data-testid="home-programs">
        <span><b>Готовые программы</b><small>План на каждый день: набор, сила, похудение</small></span>
        <img src={`${base}img/dumbbell.webp`} alt="" width="84" height="84" />
      </a>
      <section class="gsect">
        <h2>Группы мышц</h2>
        <nav class="groups" aria-label="Группы мышц">
          {groups.map((g, i) => (
            <a class="gcard tinted" style={`--gc: var(--g-${g.id}); --gi: var(--gi-${g.id})`} href={`${base}myshcy/${g.slug}/`} data-g={g.id} data-testid={`group-${g.id}`}>
              <img class="win" src={`${base}img/m-${g.id}.webp`} alt="" width="438" height="360" loading="lazy" />
              <span class="foot">
                <span class="text"><b>{g.name}</b><span class="count">{countText(g.id)}</span></span>
                {/* Порядковый номер, а не число упражнений. */}
                <span class="num" aria-hidden="true" data-testid="group-number">{i + 1}</span>
              </span>
            </a>
          ))}
        </nav>
      </section>
    </div>
  </div>
</Base>

<script>
  import groups from "../data/groups.json";
  const byId = Object.fromEntries(groups.map(g => [g.id, g]));
  const base = import.meta.env.BASE_URL;
  const pick = document.querySelector<HTMLElement>(".pick")!;

  document.addEventListener("pick", ev => {
    const g = byId[(ev as CustomEvent<string>).detail];
    pick.querySelector(".pn")!.textContent = g.name;
    pick.querySelector(".ps")!.textContent = document.querySelector(`.gcard[data-g="${g.id}"] .count`)!.textContent;
    pick.querySelector("a")!.href = `${base}myshcy/${g.slug}/`;
  });
</script>

<style>
  /* Телефон: заголовок → схема → группы. Компьютер: схема справа на всю высоту. */
  .home { display: grid; grid-template-columns: minmax(0, 1fr); grid-template-areas: "title" "map" "left"; gap: 24px; align-items: start; }
  .hello { grid-area: title; }
  .map { grid-area: map; background: var(--surface); border-radius: 24px; padding: 14px; }
  .left { grid-area: left; display: grid; gap: 28px; }
  @media (min-width: 1024px) {
    .home { grid-template-columns: minmax(0, 1fr) minmax(0, 460px); grid-template-areas: "title map" "left map"; column-gap: 48px; }
    .map { position: sticky; top: 76px; }
  }
  .pick { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 8px; background: var(--bg); border-radius: 20px; padding: 10px 10px 10px 16px; }
  .pick > span { display: grid; min-width: 0; }
  .pick b { font: 800 18px var(--f-display); letter-spacing: -.02em; }
  .pick small { color: var(--soft); font-size: 13px; font-weight: 700; }
  .pick .btn { min-height: 46px; }
  .programs { display: flex; align-items: center; justify-content: space-between; gap: 10px; background: var(--surface); border-radius: 24px; padding: 14px 14px 14px 18px; text-decoration: none; }
  .programs b { display: block; font: 800 17px/1.2 var(--f-display); letter-spacing: -.02em; }
  .programs small { display: block; margin-top: 4px; color: var(--soft); font-size: 14px; line-height: 1.35; font-weight: 700; }
  .programs img { flex: none; width: 84px; height: 84px; }
  /* Длинное название не должно сжимать кнопку: на телефоне она уходит на отдельную строку. */
  .mine { margin-top: 16px; flex-wrap: wrap; }
  .mine > a:first-child { flex: 1 1 200px; min-height: 44px; text-decoration: none; }
  .gsect { display: grid; gap: 12px; }
  /* Группы — плитки в цвете блина: мышца в окне, большая бледная цифра — порядковый номер, целиком внутри отступа. */
  .groups { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .gcard { display: flex; flex-direction: column; gap: 12px; min-width: 0; padding: 10px 10px 14px; border-radius: 26px; color: var(--gi); text-decoration: none;
    transition: transform .15s; -webkit-tap-highlight-color: transparent; }
  .gcard:active { transform: scale(.97); }
  @media (hover: hover) { .gcard:hover { transform: translateY(-2px); } }
  .win { display: block; width: 100%; height: auto; aspect-ratio: 146 / 120; object-fit: cover; border-radius: 18px; background: var(--bg); }
  .foot { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 4px; padding: 0 2px 0 6px; }
  .text { display: grid; gap: 2px; min-width: 0; }
  .gcard b { font: 800 15px/1.2 var(--f-display); letter-spacing: -.02em; }
  .count { font-size: 13px; line-height: 1.3; font-weight: 800; white-space: nowrap; }
  .num { font: 800 38px/.9 var(--f-display); letter-spacing: -.04em; opacity: .34; }
  /* Седьмая плитка на всю ширину: окно слева, текст справа. */
  .gcard:last-child { grid-column: 1 / -1; display: grid; grid-template-columns: 146px minmax(0, 1fr); align-items: center; gap: 10px; }
  @media (min-width: 768px) {
    .groups { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .gcard:last-child { grid-column: span 2; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  }
  /* Рядом со схемой левая колонка узкая: в четыре ряда текст наехал бы на цифру. */
  @media (min-width: 1024px) and (max-width: 1279px) {
    .groups { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .gcard:last-child { grid-column: 1 / -1; grid-template-columns: 146px minmax(0, 1fr); }
    .num { font-size: 30px; }
  }
  @media (prefers-reduced-motion: reduce) { .gcard { transition: none; } }
</style>
