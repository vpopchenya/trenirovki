---
import Base from "../layouts/Base.astro";
import BodyMap from "../components/BodyMap.astro";
import InstallCard from "../components/InstallCard.astro";
import BodyDefs from "../components/BodyDefs.astro";
import MuscleIcon from "../components/MuscleIcon.astro";
import { getCollection } from "astro:content";
import groups from "../data/groups.json";
import { plural } from "../lib/catalog";
import { subsText } from "../lib/groups";

const all = await getCollection("exercises");
const count = (id: string) => all.filter(e => e.data.group === id).length;
const base = import.meta.env.BASE_URL;
const first = groups[0];
---
<Base jsonLd={{ "@context": "https://schema.org", "@type": "WebSite", name: "Карманный тренер", inLanguage: "ru", url: new URL(base, Astro.site).href }} title="Карманный тренер" description="Бесплатный каталог упражнений для зала и дома: 7 групп мышц, техника по шагам на русском и частые ошибки. Работает на телефоне.">
  <div class="home">
    <div class="hello">
      <p class="hi">Привет! Начнём?</p>
      <h1 data-testid="home-title">Что качаем <em class="wave">сегодня?</em></h1>
    </div>

    <section class="map" aria-label="Выбор мышцы">
      <BodyMap selected={first.id} clickable />
      <div class="pick" data-testid="picked-group" style={`--gc: var(--g-${first.id})`}>
        <span><b class="pn">{first.name}</b><small class="ps">{subsText(first)}</small></span>
        <a class="btn main" href={`${base}myshcy/${first.slug}/`}>Упражнения →</a>
      </div>
    </section>

    <div class="left">
      <InstallCard />
      <p class="lead">Нажми на мышцу на схеме или выбери группу. У каждого упражнения — техника по шагам и частые ошибки.</p>
      <BodyDefs sides={["front", "back"]} />
      <nav class="groups" aria-label="Группы мышц">
        {groups.map(g => (
          <a class:list={["gcard", { sel: g.id === first.id }]} style={`--gc: var(--g-${g.id}); --gi: var(--gi-${g.id})`} href={`${base}myshcy/${g.slug}/`} data-g={g.id} data-testid={`group-${g.id}`}>
            <span class="disc"><MuscleIcon group={g} class="gmuscle" /></span>
            {count(g.id) > 0 && <span class="big" aria-hidden="true">{count(g.id)}</span>}
            <b>{g.name}</b><span class="subs">{subsText(g)}</span><em>{count(g.id) ? `${count(g.id)} ${plural(count(g.id))}` : "скоро"}</em>
          </a>
        ))}
      </nav>
      <div>
        <p class="eyebrow">Основы</p>
        <div class="basics">
          <div><b>Сон</b><span>Сколько спать, чтобы росли мышцы</span><span class="soon">скоро</span></div>
          <div><b>Питание</b><span>Белок, калории, вода — без диет</span><span class="soon">скоро</span></div>
        </div>
      </div>
    </div>
  </div>
</Base>

<script>
  import groups from "../data/groups.json";
  import { subsText } from "../lib/groups";
  const byId = Object.fromEntries(groups.map(g => [g.id, g]));
  const base = import.meta.env.BASE_URL;
  const pick = document.querySelector<HTMLElement>(".pick")!;

  document.addEventListener("pick", ev => {
    const g = byId[(ev as CustomEvent<string>).detail];
    pick.style.setProperty("--gc", `var(--g-${g.id})`);
    pick.querySelector(".pn")!.textContent = g.name;
    pick.querySelector(".ps")!.textContent = subsText(g);
    pick.querySelector("a")!.href = `${base}myshcy/${g.slug}/`;
    document.querySelectorAll<HTMLElement>(".gcard").forEach(c => c.classList.toggle("sel", c.dataset.g === g.id));
  });
</script>

<style>
  /* Телефон: заголовок → схема → группы. Компьютер: схема справа на всю высоту. */
  .home { display: grid; grid-template-columns: minmax(0, 1fr); grid-template-areas: "title" "map" "left"; gap: 24px; align-items: start; }
  .hello { grid-area: title; }
  .hi { margin: 0 0 6px; font-weight: 800; font-size: 15px; color: var(--accent); }
  .map { grid-area: map; background: var(--surface); border-radius: 24px; padding: 14px; }
  .left { grid-area: left; display: grid; gap: 28px; }
  @media (min-width: 1024px) {
    .home { grid-template-columns: minmax(0, 1fr) minmax(0, 460px); grid-template-areas: "title map" "left map"; column-gap: 48px; }
    .map { position: sticky; top: 76px; }
  }
  /* Мелкие группы — отдельной строкой на всю ширину: рядом с кнопкой они ломались по одному слову. */
  .pick { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 4px 12px; margin-top: 8px; background: var(--bg); border-radius: 16px; padding: 12px 14px; border-left: 6px solid var(--gc); }
  .pick > span { display: contents; }
  .pick b { font: 800 19px var(--f-display); letter-spacing: -.02em; }
  .pick .btn { grid-row: 1; grid-column: 2; }
  .pick small { grid-column: 1 / -1; color: var(--muted); font-size: 13px; }
  /* Группы — плитки целиком в цвете блина: мышца в тёмном «диске», крупная бледная цифра — сколько упражнений. */
  .groups { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; }
  .gcard { display: flex; flex-direction: column; justify-content: flex-end; gap: 2px; min-height: 150px; background: var(--gc); color: var(--gi);
    border-radius: 26px; padding: 14px 16px; text-decoration: none; position: relative; overflow: hidden;
    transition: transform .15s cubic-bezier(.3, 1.5, .5, 1), box-shadow .15s; -webkit-tap-highlight-color: transparent; }
  .gcard:active { transform: scale(.95) rotate(-1deg); }
  @media (hover: hover) { .gcard:hover { transform: translateY(-3px); } }
  .disc { position: absolute; left: 12px; top: 12px; width: 52px; height: 52px; border-radius: 50%; background: var(--bg); overflow: hidden; }
  .disc :global(.gmuscle) { width: 100%; height: 100%; display: block; }
  .big { position: absolute; right: 10px; top: -10px; font: 800 76px/1 var(--f-display); letter-spacing: -.06em; opacity: .2; pointer-events: none; }
  .gcard b { font: 800 17px var(--f-display); letter-spacing: -.02em; margin-top: 64px; }
  .gcard .subs { font-size: 13px; line-height: 1.35; font-weight: 700; }
  .gcard em { font-style: normal; font-weight: 800; font-size: 12px; margin-top: 4px; }
  /* На телефоне плиток две в ряд: нечётная последняя растягивается, чтобы не висела одна. */
  @media (max-width: 559px) { .gcard:last-child:nth-child(odd) { grid-column: 1 / -1; min-height: 120px; } }
  .gcard.sel { box-shadow: 0 0 0 3px var(--bg), 0 0 0 6px var(--gc); }
  @media (prefers-reduced-motion: reduce) { .gcard { transition: none; } }
  .basics { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 10px; }
  .basics div { background: var(--surface); border-radius: 22px; padding: 16px; display: grid; gap: 2px; justify-items: start; }
  .basics span:not(.soon) { color: var(--muted); font-size: 14px; }
  .basics .soon { margin: 6px 0 0; }
</style>
