---
import Base from "../../layouts/Base.astro";
import Barbell from "../../components/Barbell.astro";
import HealthWarning from "../../components/HealthWarning.astro";
import { allPrograms, breadcrumbs, plural, pluralWeeks, BAND_SAFETY, FAT_LOSS_LINK, FAT_LOSS_NOTE, HEAVY_WARNING, HOME_PROGRESS_RULE, MY_PROGRAM_KEY, NO_BAND_NOTE, PROGRESS_RULE, REST_RULE } from "../../lib/catalog";

export async function getStaticPaths() {
  return (await allPrograms()).map(p => ({ params: { id: p.id }, props: { p } }));
}
const { p } = Astro.props;
const base = import.meta.env.BASE_URL;
const perDay = Math.max(...p.days.map(d => d.items.length));
---
<Base nav="programs" back={{ href: `${base}programmy/`, label: "Программы" }} title={p.name} description={p.description}
  jsonLd={breadcrumbs(Astro.site!, [["Каталог", base], ["Программы", `${base}programmy/`], [p.name, `${base}programmy/${p.id}/`]])}>
  <nav class="crumbs" aria-label="Путь"><a href={base}>Каталог</a><span>/</span><a href={`${base}programmy/`}>Программы</a><span>/</span><span>{p.name}</span></nav>
  <div class="phead">
    <h1 data-testid="program-title">{p.name}</h1>
    <div class="facts">
      <div><b>{p.daysPerWeek}</b>раза в неделю</div>
      <div><b>{p.weeks}</b>{pluralWeeks(p.weeks)}</div>
      <div><b>{perDay}</b>{plural(perDay)}</div>
    </div>
    <p class="lead">{p.description}</p>
    {/* Без JavaScript выбрать нечем, поэтому кнопку показывает скрипт. */}
    <div class="mine" hidden>
      <a class="btn main" href={`${base}trenirovka/`} data-testid="start-workout-link" hidden>Начать тренировку</a>
      <button class="btn main" type="button" aria-pressed="false" data-testid="my-program-btn">Моя программа</button>
      <p role="status" data-testid="my-program-hint"></p>
    </div>
  </div>
  {/* Сразу за разметкой, а не в конце страницы: кнопка не прыгает. pageshow — вернулись «Назад» из кэша браузера,
      а там могла быть выбрана другая программа. */}
  <script is:inline define:vars={{ KEY: MY_PROGRAM_KEY, id: p.id }}>
    const box = document.querySelector(".mine"), btn = box.querySelector("button"), hint = box.querySelector("p"), start = box.querySelector("a");
    const read = () => { try { return localStorage.getItem(KEY); } catch { return null; } };
    const show = () => {
      const mine = read() === id;
      start.hidden = !mine;
      btn.setAttribute("aria-pressed", String(mine));
      btn.textContent = mine ? "✓ Моя программа" : "Моя программа";
      hint.textContent = mine ? "Откроется сразу с главной. Нажми ещё раз, чтобы убрать." : "";
    };
    btn.addEventListener("click", () => {
      try {
        const chosen = read() !== id;
        if (chosen) localStorage.setItem(KEY, id); else localStorage.removeItem(KEY);
        show();
        // Цель — только на выбор: снятие отметки программу не выбирает.
        if (chosen) dispatchEvent(new CustomEvent("goal", { detail: "program_chosen" }));
      } catch {
        hint.textContent = "Браузер не дал запомнить программу.";
      }
    });
    box.hidden = false;
    show();
    addEventListener("pageshow", show);
  </script>
  {p.goal === "похудение" && (
    <p class="how" data-testid="fat-loss-note">{FAT_LOSS_NOTE} <a href={`${base}osnovy/pitanie/`} data-testid="fat-loss-link">{FAT_LOSS_LINK}</a></p>
  )}
  {p.home && <p class="how" data-testid="no-band-note">{NO_BAND_NOTE}</p>}

  <div class="days">
    {p.days.map(d => (
      <details class="day" open data-testid="program-day">
        <summary><b>{d.name}</b><span>{d.items.length} упр.</span></summary>
        <Barbell groups={d.groups} />
        <p class="mus">{d.muscles}</p>
        <div>
          {d.items.map(i => (
            <a class="ex" href={`${base}uprazhneniya/${i.ex.id}/`} style={`--gc: var(--g-${i.ex.data.group})`} data-testid="program-exercise">
              <i></i>
              <b>{i.ex.data.name}{i.note && <small>{i.note}</small>}</b>
              <span>{i.sets} × {i.reps}<small>отдых {i.rest}</small></span>
            </a>
          ))}
        </div>
      </details>
    ))}
  </div>
  {/* На телефоне открыт первый день, остальные свёрнуты. В разметке открыты все: для поиска и без JavaScript.
      Какие дни открыты, помним до закрытия вкладки: сходил посмотреть технику, вернулся — твой день не свернулся. */}
  <script is:inline>
    if (matchMedia("(max-width: 1023px)").matches) {
      const days = [...document.querySelectorAll(".day")], key = "days:" + location.pathname;
      let saved = null;
      try { saved = JSON.parse(sessionStorage.getItem(key)); } catch {}
      days.forEach((d, i) => { d.open = saved ? saved.includes(i) : i === 0; });
      days.forEach(d => d.addEventListener("toggle", () => {
        try { sessionStorage.setItem(key, JSON.stringify(days.flatMap((x, i) => x.open ? [i] : []))); } catch {}
      }));
    }
  </script>

  <section class="how">
    <h2>Как прибавлять</h2>
    <p>{p.home ? HOME_PROGRESS_RULE : PROGRESS_RULE}</p>
  </section>
  <section class="how">
    <h2>Когда тренироваться</h2>
    <p>{REST_RULE}</p>
  </section>
  <HealthWarning>{p.home ? `${BAND_SAFETY}.` : HEAVY_WARNING}</HealthWarning>
</Base>

<script>
  dispatchEvent(new CustomEvent("goal", { detail: "program_open" }));
</script>

<style>
  .phead { display: grid; gap: 14px; }
  .facts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; max-width: 480px; }
  .facts div { background: var(--surface); border-radius: 16px; padding: 10px 6px; text-align: center; font-size: 13px; color: var(--muted); }
  .facts b { display: block; font: 800 20px var(--f-display); color: var(--fg); }
  .mine { display: grid; gap: 6px; justify-items: start; }
  .mine .btn { min-height: 48px; box-sizing: border-box; }
  /* Выбрана — кнопка спокойная: главное действие на странице уже сделано. */
  .mine .btn[aria-pressed="true"] { background: var(--surface); color: var(--accent); box-shadow: inset 0 0 0 2px var(--accent); }
  .mine p { margin: 0; font-size: 14px; color: var(--muted); }
  @media (min-width: 1024px) {
    .phead { grid-template-columns: minmax(0, 1fr) minmax(300px, 420px); column-gap: 40px; align-items: end; }
    .facts { grid-column: 2; grid-row: 1; width: 100%; }
    .lead, .mine { grid-column: 1; }
  }
  .days { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 330px), 1fr)); gap: 12px; align-items: start; margin-top: 20px; }
  .day { background: var(--surface); border-radius: 22px; padding: 10px 16px 14px; }
  /* Своя галочка: у summary с display: flex стандартная стрелка пропадает, и день не выглядит раскрывающимся. */
  summary { display: flex; align-items: center; gap: 10px; min-height: 44px; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: ""; width: 9px; height: 9px; margin-right: 3px; border: solid var(--fg); border-width: 0 2px 2px 0; transform: translateY(-2px) rotate(45deg); }
  .day[open] summary::after { transform: translateY(2px) rotate(-135deg); }
  summary b { font-weight: 800; font-size: 20px; }
  summary span { font: 500 14px var(--f-mono); color: var(--muted); margin-left: auto; }
  .mus { margin: 6px 0 4px; font-size: 15px; color: var(--muted); }
  /* В зале на экран смотрят мельком: подходы — отдельной крупной строкой под названием, а не мелко сбоку. */
  .ex { display: grid; grid-template-columns: 12px minmax(0, 1fr); gap: 4px 12px; align-items: center; min-height: 48px; padding: 12px 0; border-bottom: 1px solid var(--line); text-decoration: none; }
  .ex:last-child { border-bottom: 0; }
  .ex i { width: 12px; height: 12px; margin-top: 5px; align-self: start; border-radius: 50%; background: var(--gc); }
  .ex b { font-weight: 800; font-size: 18px; line-height: 1.25; }
  .ex > span { grid-column: 2; display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 12px; font: 500 17px var(--f-mono); color: var(--fg); }
  .ex small { display: block; font: 500 15px var(--f-body); color: var(--muted); }
  .how { background: var(--surface); border-radius: 22px; padding: 16px; margin-top: 12px; max-width: 70ch; }
  .how p { margin: 6px 0 0; color: var(--text); }
  .how a { display: inline-block; padding: 6px 0; font-weight: 800; color: var(--accent); text-underline-offset: 3px; white-space: nowrap; }
  .how + :global(.warn) { margin-top: 12px; max-width: 70ch; }
</style>
