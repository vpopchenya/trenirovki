---
// Мужская фигура один раз на странице, в <defs>: значки групп и миниатюры ссылаются на неё через <use>
// (#body-front / #body-back) и приближают нужную мышцу (viewBox из groups.json, см. MuscleIcon).
// Какая мышца цветная, решает сам значок: у мышцы группы X цвет var(--hl-X), а его задаёт MuscleIcon.
import body from "../data/body.json";
import type { Side } from "../lib/catalog";

interface Props { sides: Side[] }
const { sides } = Astro.props;
---
<svg class="defs" aria-hidden="true" focusable="false"><defs>
  {[...new Set(sides)].map(side => (
    <g id={`body-${side}`}>
      <path d={body.m[side].outline} style="fill: var(--skin)" />
      {body.m[side].parts.map(([g, ds]) => (ds as string[]).map(d =>
        g ? <path d={d} style={`fill: var(--hl-${g}, var(--muscle))`} /> : <path d={d} style="fill: var(--muscle); opacity: .55" />))}
    </g>
  ))}
</defs></svg>

<style>
  .defs { position: absolute; width: 0; height: 0; overflow: hidden; }
</style>
