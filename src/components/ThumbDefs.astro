---
// Одна мужская фигура на странице, в <defs>: миниатюры в карточках ссылаются на неё через <use>
// и приближают свою группу мышц (viewBox из groups.json). Так фигура не повторяется в каждой карточке.
import body from "../data/body.json";
import type { Group, Side } from "../lib/catalog";

interface Props { group: Group }
const { group } = Astro.props;
const fig = body.m[group.side as Side];
---
<svg class="defs" aria-hidden="true" focusable="false"><defs><g id="thumb-body">
  <path d={fig.outline} style="fill: var(--skin)" />
  {fig.parts.map(([g, ds]) => (ds as string[]).map(d =>
    <path d={d} style={g === group.id ? `fill: var(--g-${g})` : "fill: var(--muscle)"} />))}
</g></defs></svg>

<style>
  .defs { position: absolute; width: 0; height: 0; overflow: hidden; }
</style>
