---
// Страница группы мышц и страница её мелкой группы — одна вёрстка. Мелкие группы — ссылки на свои страницы
// (они нужны для поиска: «упражнения на верх груди»), оборудование фильтруется прямо на странице.
import Base from "../layouts/Base.astro";
import BodyDefs from "./BodyDefs.astro";
import MuscleIcon from "./MuscleIcon.astro";
import { exercisesOf, subsWithExercises, slugify, plural, levelClass, breadcrumbs, isHome, type Group, type Side } from "../lib/catalog";

interface Props { group: Group; sub?: string }
const { group, sub } = Astro.props;
const base = import.meta.env.BASE_URL;
const groupUrl = `${base}myshcy/${group.slug}/`;
const list = (await exercisesOf(group.id)).filter(e => !sub || e.data.sub === sub);
const subs = await subsWithExercises(group);
const equipment = [...new Set(list.flatMap(e => e.data.equipment))];
// «Без зала» нужен, только когда он что-то отсекает: есть и домашние упражнения, и зальные.
const homeCount = list.filter(e => isHome(e.data.equipment)).length;
const homeChip = homeCount > 0 && homeCount < list.length;

// «и дома» в описании для поиска — только там, где домашние упражнения правда есть.
const where = homeCount > 0 ? "в зале и дома" : "в зале";
const title = sub ? `Упражнения на ${group.acc}: ${sub.toLowerCase()}` : `Упражнения на ${group.acc}`;
const description = sub
  ? `${sub} — упражнения на ${group.acc} ${where}. Техника по шагам и частые ошибки.`
  : `Упражнения на ${group.acc} ${where}: ${group.subs.join(", ").toLowerCase()}. Техника по шагам и частые ошибки.`;
---
<Base title={title} description={description} back={sub ? { href: groupUrl, label: group.name, group: group.id } : { href: base, label: "Каталог" }} jsonLd={breadcrumbs(Astro.site!, [
  ["Каталог", base], [group.name, groupUrl], ...(sub ? [[sub, `${groupUrl}${slugify(sub)}/`] as [string, string]] : []),
])}>
  <div style={`--gc: var(--g-${group.id}); --gi: var(--gi-${group.id})`}>
    <nav class="crumbs" aria-label="Путь">
      <a href={base}>Каталог</a><span>/</span>
      {sub ? <><a href={groupUrl}>{group.name}</a><span>/</span><span>{sub}</span></> : <span>{group.name}</span>}
    </nav>
    <div class="ghead">
      <BodyDefs sides={[group.side as Side]} />
      <MuscleIcon group={group} class="gicon" />
      <div>
        <h1 data-testid="group-title">{sub ? <>{group.name}: <em class="wave">{sub.toLowerCase()}</em></> : group.name}</h1>
        <p class="eyebrow">{list.length > 0 && `${list.length} ${plural(list.length)} · `}{group.subs.join(" · ")}</p>
      </div>
    </div>

    {list.length === 0 ? (
      <p class="lead empty" data-testid="group-empty">Упражнения на эту группу скоро появятся.</p>
    ) : (
      <>
        <div class="filters">
          {subs.length > 1 && (
            <div class="frow">
              <p class="flabel" id="lbl-sub" data-testid="filter-sub-label">Часть тела</p>
              <nav class="chips" aria-labelledby="lbl-sub">
                <a class="chip" href={groupUrl} aria-current={!sub ? "page" : undefined} data-testid="filter-sub-all">Все</a>
                {subs.map(s => <a class="chip" href={`${groupUrl}${slugify(s)}/`} aria-current={s === sub ? "page" : undefined} data-testid={`filter-sub-${slugify(s)}`}>{s}</a>)}
              </nav>
            </div>
          )}
          {equipment.length > 1 && (
            <div class="frow">
              <p class="flabel" id="lbl-eq" data-testid="filter-eq-label">Инвентарь</p>
              <div class="chips" data-f="eq" role="group" aria-labelledby="lbl-eq">
                <button class="chip" type="button" aria-pressed="true" data-v="" data-testid="filter-eq-all">Любое</button>
                {homeChip && <button class="chip" type="button" aria-pressed="false" data-v="home" data-testid="filter-eq-home">🏠 Без зала</button>}
                {equipment.map(s => <button class="chip" type="button" aria-pressed="false" data-v={s} data-testid={`filter-eq-${slugify(s)}`}>{s}</button>)}
              </div>
            </div>
          )}
        </div>
        <div class="exlist">
          {list.map(e => (
            <a class="ex" href={`${base}uprazhneniya/${e.id}/`} data-eq={e.data.equipment.join("|")} data-home={String(isHome(e.data.equipment))} data-ex={e.id} data-testid="exercise-card">
              <MuscleIcon group={group} class="thumb" />
              <span>
                <b>{e.data.name}</b>
                <span class="tags">
                  <span class="tag">{e.data.sub}</span>
                  <span class="tag">{e.data.equipment.join(", ")}</span>
                  <span class:list={["tag", levelClass(e.data.level)]}>{e.data.level}</span>
                </span>
              </span>
            </a>
          ))}
        </div>
        <p class="lead nothing" data-testid="filter-empty" hidden>С таким инвентарём упражнений нет. Нажми «Любое».</p>
      </>
    )}
  </div>
</Base>

<script>
  const cards = document.querySelectorAll<HTMLElement>(".ex");
  const nothing = document.querySelector<HTMLElement>(".nothing");
  document.querySelectorAll<HTMLElement>('[data-f="eq"]').forEach(row => row.addEventListener("click", ev => {
    const b = (ev.target as Element).closest<HTMLButtonElement>(".chip");
    if (!b) return;
    const eq = b.dataset.v!;
    row.querySelectorAll(".chip").forEach(x => x.setAttribute("aria-pressed", String(x === b)));
    let shown = 0;
    cards.forEach(c => {
      c.hidden = eq === "home" ? c.dataset.home !== "true" : !!eq && !c.dataset.eq!.split("|").includes(eq);
      if (!c.hidden) shown++;
    });
    if (nothing) nothing.hidden = shown > 0;
  }));
</script>

<style>
  .ghead { display: flex; align-items: center; gap: 14px; }
  .ghead > div { min-width: 0; }
  .ghead .eyebrow { margin: 12px 0 0; } /* место под волнистое подчёркивание заголовка */
  .ghead :global(.gicon) { width: 68px; height: 68px; flex: none; border-radius: 50%; display: block; background: var(--bg); box-shadow: 0 0 0 4px var(--gc); }
  .empty, .nothing { margin-top: 24px; }
  .filters { display: grid; gap: 14px; margin: 24px 0 20px; }
  .frow { display: grid; gap: 6px; }
  .flabel { margin: 0; font: 500 12px var(--f-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .chips { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; padding-bottom: 2px; }
  .chip { flex: none; display: inline-flex; align-items: center; font-weight: 800; font-size: 14px; text-decoration: none; background: var(--surface); border: 1px solid var(--line); border-radius: 999px; padding: 0 14px; min-height: 40px; cursor: pointer; }
  .chip { transition: transform .1s; -webkit-tap-highlight-color: transparent; }
  .chip:active { transform: scale(.95); }
  .chip[aria-pressed="true"], .chip[aria-current="page"] { border-color: var(--gc); background: var(--gc); color: var(--gi); }
  .exlist { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 12px; }
  .ex { display: grid; grid-template-columns: 72px minmax(0, 1fr); gap: 14px; align-items: center; background: color-mix(in srgb, var(--gc) 10%, var(--surface));
    border-radius: 24px; padding: 12px; text-decoration: none; border: 1px solid transparent; transition: transform .15s cubic-bezier(.3, 1.5, .5, 1); -webkit-tap-highlight-color: transparent; }
  .ex:active { transform: scale(.97); }
  @media (hover: hover) { .ex:hover { border-color: color-mix(in srgb, var(--gc) 50%, transparent); } }
  .ex :global(.thumb) { width: 72px; height: 72px; border-radius: 50%; background: var(--bg); display: block; box-shadow: 0 0 0 3px var(--gc); }
  .ex b { display: block; font-weight: 800; font-size: 17px; line-height: 1.3; }
  @media (prefers-reduced-motion: reduce) { .ex, .chip { transition: none; } }
  .ex .tags { margin-top: 6px; }
</style>
