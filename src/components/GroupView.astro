---
// Страница группы мышц и страница её мелкой группы — одна вёрстка. Мелкие группы — ссылки на свои страницы
// (они нужны для поиска: «упражнения на верх груди»), оборудование фильтруется прямо на странице.
import Base from "../layouts/Base.astro";
import { exercisesOf, subsWithExercises, slugify, plural, levelClass, levelLabel, equipmentIcon, equipmentText, breadcrumbs, isHome, HOME_LABEL, type Group } from "../lib/catalog";

interface Props { group: Group; sub?: string }
const { group, sub } = Astro.props;
const base = import.meta.env.BASE_URL;
const groupUrl = `${base}myshcy/${group.slug}/`;
const list = (await exercisesOf(group.id)).filter(e => !sub || e.data.sub === sub);
const subs = await subsWithExercises(group);
const equipment = [...new Set(list.flatMap(e => e.data.equipment))];
// «Без зала» нужен, только когда он что-то отсекает: есть и домашние упражнения, и зальные.
const homeCount = list.filter(e => isHome(e.data.equipment)).length;
const homeChip = homeCount > 0 && homeCount < list.length;

// «и дома» в описании для поиска — только там, где домашние упражнения правда есть.
const where = homeCount > 0 ? "в зале и дома" : "в зале";
const title = sub ? `Упражнения на ${group.acc}: ${sub.toLowerCase()}` : `Упражнения на ${group.acc}`;
const description = sub
  ? `${sub} — упражнения на ${group.acc} ${where}. Техника по шагам и частые ошибки.`
  : `Упражнения на ${group.acc} ${where}: ${group.subs.join(", ").toLowerCase()}. Техника по шагам и частые ошибки.`;
---
<Base title={title} description={description} back={sub ? { href: groupUrl, label: group.name, group: group.id } : { href: base, label: "Каталог" }} jsonLd={breadcrumbs(Astro.site!, [
  ["Каталог", base], [group.name, groupUrl], ...(sub ? [[sub, `${groupUrl}${slugify(sub)}/`] as [string, string]] : []),
])}>
  <div style={`--gc: var(--g-${group.id}); --gi: var(--gi-${group.id})`}>
    <nav class="crumbs" aria-label="Путь">
      <a href={base}>Каталог</a><span>/</span>
      {sub ? <><a href={groupUrl}>{group.name}</a><span>/</span><span>{sub}</span></> : <span>{group.name}</span>}
    </nav>
    <section class="ghead tinted">
      <img src={`${base}img/m-${group.id}.webp`} alt="" width="438" height="360" />
      <div>
        <h1 data-testid="group-title">{sub ? `${group.name}: ${sub.toLowerCase()}` : group.name}</h1>
        {list.length > 0 && <p>{list.length} {plural(list.length)}</p>}
      </div>
    </section>

    {list.length === 0 ? (
      <p class="lead empty" data-testid="group-empty">Упражнения на эту группу скоро появятся.</p>
    ) : (
      <>
        <div class="filters">
          {subs.length > 1 && (
            <div class="frow">
              <p class="flabel" id="lbl-sub" data-testid="filter-sub-label">Часть тела</p>
              <nav class="chips" aria-labelledby="lbl-sub">
                <a class="chip" href={groupUrl} aria-current={!sub ? "page" : undefined} data-testid="filter-sub-all">Все</a>
                {subs.map(s => <a class="chip" href={`${groupUrl}${slugify(s)}/`} aria-current={s === sub ? "page" : undefined} data-testid={`filter-sub-${slugify(s)}`}>{s}</a>)}
              </nav>
            </div>
          )}
          {equipment.length > 1 && (
            <div class="frow">
              <p class="flabel" id="lbl-eq" data-testid="filter-eq-label">Инвентарь</p>
              <div class="chips" data-f="eq" role="group" aria-labelledby="lbl-eq">
                <button class="chip" type="button" aria-pressed="true" data-v="" data-testid="filter-eq-all">Любой</button>
                {homeChip && <button class="chip" type="button" aria-pressed="false" data-v="home" data-testid="filter-eq-home">{HOME_LABEL}</button>}
                {equipment.map(s => <button class="chip" type="button" aria-pressed="false" data-v={s} data-testid={`filter-eq-${slugify(s)}`}>{s}</button>)}
              </div>
            </div>
          )}
        </div>
        <div class="exlist">
          {list.map(e => (
            <a class="ex" href={`${base}uprazhneniya/${e.id}/`} data-eq={e.data.equipment.join("|")} data-home={String(isHome(e.data.equipment))} data-ex={e.id} data-testid="exercise-card">
              <span class="iconbox"><img src={`${base}img/${equipmentIcon(e.data.equipment)}.webp`} alt="" width="58" height="58" loading="lazy" /></span>
              <span class="txt">
                <b>{e.data.name}</b>
                <span class="info">{e.data.sub} · {equipmentText(e.data.equipment)}</span>
                <span class:list={["level", levelClass(e.data.level)]}>{levelLabel(e.data.level)}</span>
              </span>
            </a>
          ))}
        </div>
        <p class="lead nothing" data-testid="filter-empty" hidden>С таким инвентарём упражнений нет. Нажми «Любой».</p>
      </>
    )}
  </div>
</Base>

<script>
  const cards = document.querySelectorAll<HTMLElement>(".ex");
  const nothing = document.querySelector<HTMLElement>(".nothing");
  document.querySelectorAll<HTMLElement>('[data-f="eq"]').forEach(row => row.addEventListener("click", ev => {
    const b = (ev.target as Element).closest<HTMLButtonElement>(".chip");
    if (!b) return;
    const eq = b.dataset.v!;
    row.querySelectorAll(".chip").forEach(x => x.setAttribute("aria-pressed", String(x === b)));
    let shown = 0;
    cards.forEach(c => {
      c.hidden = eq === "home" ? c.dataset.home !== "true" : !!eq && !c.dataset.eq!.split("|").includes(eq);
      if (!c.hidden) shown++;
    });
    if (nothing) nothing.hidden = shown > 0;
  }));
</script>

<style>
  .ghead { display: flex; align-items: center; gap: 14px; padding: 10px; border-radius: 28px; color: var(--gi); }
  .ghead img { flex: none; display: block; width: 146px; height: 120px; object-fit: cover; border-radius: 20px; background: var(--bg); }
  .ghead > div { min-width: 0; }
  .ghead h1 { font-size: clamp(22px, 3.4vw, 34px); overflow-wrap: anywhere; }
  .ghead p { margin: 2px 0 0; font-size: 14px; font-weight: 800; }
  .empty, .nothing { margin-top: 24px; }
  .filters { display: grid; gap: 14px; margin: 14px 0; }
  .exlist { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 10px; }
  .ex { display: grid; grid-template-columns: 72px minmax(0, 1fr); align-items: center; gap: 14px; min-height: 92px; padding: 10px 14px 10px 10px; border-radius: 22px; background: var(--surface); text-decoration: none;
    transition: transform .15s; -webkit-tap-highlight-color: transparent; }
  .ex:active { transform: scale(.98); }
  @media (hover: hover) { .ex:hover { background: var(--surface2); } }
  @media (prefers-reduced-motion: reduce) { .ex { transition: none; } }
  .txt { display: grid; gap: 2px; min-width: 0; }
  .txt b { font-size: 16px; line-height: 1.25; font-weight: 800; }
  .info { font-size: 13px; line-height: 1.35; font-weight: 700; color: var(--soft); }
  .level { font-size: 13px; line-height: 1.3; font-weight: 800; }
</style>
