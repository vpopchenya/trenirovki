---
// Значок группы мышц: фигура из BodyDefs, приближена к своей группе, группа — в её цвете.
// На странице должен быть <BodyDefs> с нужной стороной (group.side).
import type { Group } from "../lib/catalog";

interface Props { group: Group; class?: string }
const { group, class: cls } = Astro.props;
---
<svg class={cls} viewBox={group.thumb} aria-hidden="true" style={`--hl-${group.id}: var(--g-${group.id})`}>
  <use href={`#body-${group.side}`} />
</svg>
