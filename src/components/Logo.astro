---
// Знак «Карманного тренера»: человечек выжимает штангу, блины — цветов групп мышц (красный и синий).
// Тот же рисунок — в public/favicon.svg и в иконках приложения public/icons/*.png.
interface Props { size?: number }
const { size = 28 } = Astro.props;
---
<svg class="logo-mark" width={size} height={size} viewBox="0 0 100 100" aria-hidden="true">
  <rect x="10" y="20" width="80" height="6" rx="3" fill="#eef0f2" />
  <rect x="6" y="10" width="10" height="26" rx="3" fill="#e5322d" />
  <rect x="84" y="10" width="10" height="26" rx="3" fill="#2f6fe0" />
  <path d="M36 23 L44 46 M64 23 L56 46" stroke="#ff7a1a" stroke-width="8" stroke-linecap="round" fill="none" />
  <circle cx="50" cy="40" r="8" fill="#ff7a1a" />
  <path d="M40 50 Q50 46 60 50 L57 72 L43 72 Z" fill="#ff7a1a" />
  <path d="M45 72 L40 92 M55 72 L60 92" stroke="#ff7a1a" stroke-width="8" stroke-linecap="round" fill="none" />
</svg>
